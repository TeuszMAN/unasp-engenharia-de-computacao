// Copie este arquivo para secrets.h (na mesma pasta) e preencha com a sua rede
// e com a senha do usuario esp32 do broker (infra/raspberry-pi/.env).
// O secrets.h esta no .gitignore e nunca vai para o GitHub.
#pragma once

#define WIFI_SSID "nome_da_rede"
#define WIFI_PASSWORD "senha_da_rede"

// Broker MQTT na Raspberry Pi. O ESP32 procura a Pi pelo nome mDNS e, se ela
// nao responder, usa o IP abaixo (vale reservar esse IP no DHCP do roteador).
#define MQTT_USER "esp32"
#define MQTT_PASSWORD "senha_do_usuario_esp32"
#define MQTT_HOST_MDNS "rasp400"
#define MQTT_HOST_IP "192.168.1.214"

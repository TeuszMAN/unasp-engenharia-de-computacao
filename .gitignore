!/ArquiteturaII/batalha-naval-mips/

!/infra/
!/docs/

# Regras gerais, valem dentro das pastas liberadas
.pio/
.venv/
venv/
__pycache__/
.ipynb_checkpoints/
.vscode/
secrets.h
.env
